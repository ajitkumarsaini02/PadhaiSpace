{
  "name": "padhaispace-monorepo",
  "version": "1.0.0",
  "description": "PadhaiSpace - Your Engineering Study Space",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "sync:notes": "cd server && npm run sync:notes",
    "sync:gdrive": "cd server && npm run sync:gdrive"
  },
  "keywords": [
    "engineering",
    "edtech",
    "notes",
    "pyq",
    "padhaispace"
  ],
  "author": "PadhaiSpace Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
